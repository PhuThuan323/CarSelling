{
  "name": "smarty/php-shop-starter",
  "description": "A PHP Smarty template engine based shopping cart application",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "smarty/smarty": "^3.1 || ^4.0",
    "vlucas/phpdotenv": "^5.7",
    "phpmailer/phpmailer": "^7.1",
    "cloudinary/cloudinary_php": "^3.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "scripts": {
    "start": "php -S localhost:8000 -t public"
  }
}
